node_modules
.next
.pglite
.env
.env.local
*.tsbuildinfo

# Large frozen inputs and regenerable artefacts. Their SHA-256 is recorded in
# docs/migration/runs/2026-09-10-step-0.md; they are not versioned here.
data/audits/
data/inputs/
data/seed/*.json
# …except the three the build imports statically. `data/seed/minnesota.ts` does
# `import generated from './minnesota.generated.json'`, so the bundler resolves them whether or not
# the code path runs. Ignoring them makes a Vercel build fail before it renders anything.
!data/seed/minnesota.generated.json
!data/seed/minnesota.faq.json
!data/seed/minnesota.media.json
public/uploads/

# regenerated by `next dev`
next-env.d.ts

# 222MB of extracted WordPress source; regenerate with scripts/extract-page-source.mjs
data/seed/*.page-source.jsonl

# vercel
.vercel
